{
  "_comment": "Region to music-cue mapping. Inspired by bootscape's music.dbtable + musicregion.dbtable system (/tmp/scape-repos/bootscape/Server/content/scripts/music/configs/), reshaped to reference cue IDs already present in data/audio-manifest.json. The audio engine reads this table when a player's tile coordinate crosses a region boundary and crossfades to the matching cue. Each entry uses the existing engine area IDs from src/content/aelgard/world-layout.js. The 'unlock_level' echoes bootscape's unlock column: 0 = always available, 1 = unlocked on first entry, N = requires reaching that level in the linked region stat.",
  "_source": "bootscape/Server/content/scripts/music/configs/musicregion.dbtable (structural), data/audio-manifest.json (cue IDs)",
  "_version": "1.0.0",
  "conventions": {
    "region_key": "matches rel.defineAreaGate region ID",
    "time_of_day": "day | night | any",
    "cue_id": "must exist in data/audio-manifest.json music[] array",
    "unlock_level": "0 = default, 1 = first-visit unlock, >1 = progression unlock"
  },
