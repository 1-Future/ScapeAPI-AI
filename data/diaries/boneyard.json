        { "id": "b_hard_2", "description": "Kill a fossil guardian.", "check": { "type": "kill_npc", "npc": "fossil_guardian" } },
        { "id": "b_hard_3", "description": "Complete the Relics of the Old World quest.", "check": { "type": "quest_complete", "quest": "relics_of_the_old_world" } },
        { "id": "b_hard_4", "description": "Mine granite (mining 45).", "check": { "type": "mine_items", "items": ["granite"], "min_level": { "mining": 45 } } },
        { "id": "b_hard_5", "description": "Kill a mummy and survive the poison.", "check": { "type": "compound", "all": [{ "type": "kill_npc", "npc": "mummy" }, { "type": "survive_status", "status": "poison" }] } },
        { "id": "b_hard_6", "description": "Collect a fossilized fang.", "check": { "type": "obtain_item", "item": "fossilized_fang" } },
        { "id": "b_hard_7", "description": "Smith a soot-iron weapon.", "check": { "type": "smith_item", "item_tag": "soot_iron_weapon" } },
        { "id": "b_hard_8", "description": "Use the Ancient Magicks spellbook in the Boneyard.", "check": { "type": "cast_spellbook", "spellbook": "ancient", "area": "boneyard" } },
        { "id": "b_hard_9", "description": "Kill a skeletal wyvern.", "check": { "type": "kill_npc", "npc": "skeletal_wyvern" } },
        { "id": "b_hard_10", "description": "Reach the bottom of the pyramid dungeon.", "check": { "type": "enter_area", "area": "pyramid_deep" } },
        { "id": "b_hard_11", "description": "Use the Enchanted Lyre at the oasis for a free song buff.", "check": { "type": "use_item_in_area", "item": "enchanted_lyre", "area": "boneyard_oasis" } },
        { "id": "b_hard_12", "description": "Complete 3 hard clue steps in the Boneyard.", "check": { "type": "clue_step_complete", "tier": "hard", "count": 3, "area": "boneyard" } },
        { "id": "b_hard_13", "description": "Complete a Shades of Mort'ton minigame round (desert variant).", "check": { "type": "minigame_complete", "minigame": "shades_of_morton" } },
        { "id": "b_hard_14", "description": "Craft 50 glassblown orbs at the Boneyard furnace.", "check": { "type": "craft_item_count", "item": "unpowered_orb", "count": 50, "area": "boneyard_furnace" } },
        { "id": "b_hard_15", "description": "Cross the shifting dunes shortcut (requires agility 60).", "check": { "type": "use_shortcut", "shortcut": "shifting_dunes", "min_level": { "agility": 60 } } }
      ],
      "reward": "Boneyard cape (hard) + desert amulet upgrade (5 teleport charges). Diary lamp (hard).",
      "perk_description": "Pyramid shortcut to deep level; +10% bone-shard mining at all desert rocks."
    },
    "elite": {
      "tasks": [
        { "id": "b_elite_1", "description": "Defeat Azhmari in under 3 minutes.", "check": { "type": "boss_kill_under_time", "boss": "azhmari_sand_prince", "seconds": 180 } },
        { "id": "b_elite_2", "description": "Complete the Desert Treasure quest.", "check": { "type": "quest_complete", "quest": "desert_treasure" } },
        { "id": "b_elite_3", "description": "Kill 100 skeletons in the Boneyard.", "check": { "type": "kill_npc", "npc": "skeleton", "count": 100, "area": "boneyard" } },
        { "id": "b_elite_4", "description": "Collect all 3 Azhmari unique drops.", "check": { "type": "collection_log_complete", "source": "azhmari_sand_prince" } },
        { "id": "b_elite_5", "description": "Mine a runite ore in the desert.", "check": { "type": "mine_items", "items": ["runite_ore"], "area": "boneyard" } },
        { "id": "b_elite_6", "description": "Complete every Boneyard quest.", "check": { "type": "all_region_quests_complete", "region": "boneyard" } },
        { "id": "b_elite_7", "description": "Kill a camel warrior.", "check": { "type": "kill_npc", "npc": "camel_warrior" } },
        { "id": "b_elite_8", "description": "Use Ice Barrage on a dust devil stack.", "check": { "type": "cast_spell_on_stack", "spell": "ice_barrage", "npc": "dust_devil", "min_targets": 3 } },
        { "id": "b_elite_9", "description": "Survive 5 minutes in the deep pyramid without food.", "check": { "type": "survive_in_area_without_food", "area": "pyramid_deep", "seconds": 300 } },
        { "id": "b_elite_10", "description": "Complete an elite clue step in the Boneyard.", "check": { "type": "clue_step_complete", "tier": "elite", "region": "boneyard" } },
        { "id": "b_elite_11", "description": "Complete the pyramid full collection log.", "check": { "type": "collection_log_complete", "source": "pyramid_dungeon" } },
        { "id": "b_elite_12", "description": "Craft 100 amulet of power using Boneyard resources.", "check": { "type": "craft_item_count", "item": "amulet_of_power", "count": 100 } },
        { "id": "b_elite_13", "description": "Complete the Boneyard Fight Arena speedrun (under 8 minutes).", "check": { "type": "minigame_complete_under_time", "minigame": "boneyard_fight_arena", "seconds": 480 } },
        { "id": "b_elite_14", "description": "Reach 99 in Mining while in the Boneyard.", "check": { "type": "skill_level_99_in_region", "skill": "mining", "region": "boneyard" } },
        { "id": "b_elite_15", "description": "Discover the sunken tomb of the Last King (deep exploration).", "check": { "type": "enter_area", "area": "sunken_tomb_last_king" } }
      ],
      "reward": "Boneyard cape (elite — sand-trim recolour), unlimited desert teleport, sandstorm immunity. Diary lamp (elite).",
      "perk_description": "Sandstorm immunity; +10% rune chance from Boneyard monsters; teleport-to-Azhmari unlocked."
    }
  }
}
