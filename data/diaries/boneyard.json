        { "id": "b_med_8", "description": "Collect 10 bone shards in one trip.", "check": { "type": "obtain_item_in_trip", "item": "bone_shard", "count": 10 } },
        { "id": "b_med_9", "description": "Pickpocket a warrior in the nomad camp.", "check": { "type": "pickpocket_npc", "npc": "warrior", "area": "nomad_camp" } },
        { "id": "b_med_10", "description": "Equip a full nomad outfit and salute Razak.", "check": { "type": "compound", "all": [{ "type": "equip_set", "set": "nomad_outfit" }, { "type": "emote_at_npc", "emote": "salute", "npc": "razak" }] } },
        { "id": "b_med_11", "description": "Complete 1 medium clue step in the nomad camp.", "check": { "type": "clue_step_complete", "tier": "medium", "area": "nomad_camp" } },
        { "id": "b_med_12", "description": "Craft 5 sandstone (5kg) at the grinder.", "check": { "type": "craft_item", "item": "sandstone_5kg", "count": 5 } },
        { "id": "b_med_13", "description": "Participate in a Pyramid Plunder minigame round.", "check": { "type": "minigame_participate", "minigame": "pyramid_plunder" } },
        { "id": "b_med_14", "description": "Set a deadfall trap and catch a desert weasel.", "check": { "type": "hunter_catch", "trap": "deadfall", "creature": "desert_weasel" } },
        { "id": "b_med_15", "description": "Light a beacon at the Boneyard signal tower (exploration).", "check": { "type": "activate_object", "object": "boneyard_signal_beacon", "area": "boneyard_signal_tower" } }
      ],
      "reward": "Boneyard cape (medium) + oasis bank teleport. Diary lamp (medium).",
      "perk_description": "Oasis bank access; +10% scarab shell drop rate; sand-storm damage halved."
