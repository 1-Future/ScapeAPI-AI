{
  "$schema": "scape.diary.v1",
  "region": "boneyard",
  "name": "Boneyard Wastes Diary",
  "summary": "Sun-bleached desert, ancient pyramids, and the bone-roads where Azhmari once ruled. Skeletons, sand crabs, and dust devils stand between you and the deep tomb.",
  "tiers": {
    "easy": {
      "tasks": [
        { "id": "b_easy_1", "description": "Kill a sand crab.", "check": { "type": "kill_npc", "npc": "sand_crab", "area": "boneyard" } },
        { "id": "b_easy_2", "description": "Mine a soot-iron ore.", "check": { "type": "mine_items", "items": ["soot_iron_ore"], "area": "boneyard" } },
        { "id": "b_easy_3", "description": "Drink a cactus water.", "check": { "type": "consume_item", "item": "cactus_water" } },
        { "id": "b_easy_4", "description": "Kill a desert wolf.", "check": { "type": "kill_npc", "npc": "desert_wolf" } },
        { "id": "b_easy_5", "description": "Kill 3 skeletons in the wastes.", "check": { "type": "kill_npc", "npc": "skeleton", "count": 3, "area": "boneyard" } },
        { "id": "b_easy_6", "description": "Buy supplies from Razak's Desert Supplies.", "check": { "type": "buy_item", "shop": "razaks_desert_supplies" } },
        { "id": "b_easy_7", "description": "Collect a bone shard from a bone crawler.", "check": { "type": "obtain_item", "item": "bone_shard" } },
        { "id": "b_easy_8", "description": "Bury bones at the oasis.", "check": { "type": "bury_bones", "area": "boneyard_oasis" } },
        { "id": "b_easy_9", "description": "Travel from the Heartlands to the Boneyard on foot.", "check": { "type": "travel", "from_area": "heartlands", "to_area": "boneyard" } },
        { "id": "b_easy_10", "description": "Pick up a scarab shell.", "check": { "type": "obtain_item", "item": "scarab_shell" } }
      ],
      "reward": "Boneyard cape (easy) + emote: shake sand. Diary lamp (easy).",
      "perk_description": "Boneyard teleport (3/day), noted fossils from skeleton drops."
    },
    "medium": {
      "tasks": [
        { "id": "b_med_1", "description": "Complete the Sand and Secrets quest.", "check": { "type": "quest_complete", "quest": "sand_and_secrets" } },
        { "id": "b_med_2", "description": "Kill a dust devil with ranged.", "check": { "type": "kill_npc", "npc": "dust_devil", "with_style": "ranged" } },
        { "id": "b_med_3", "description": "Mine sandstone (mining 35).", "check": { "type": "mine_items", "items": ["sandstone"], "min_level": { "mining": 35 } } },
        { "id": "b_med_4", "description": "Kill a giant scarab and collect its shell.", "check": { "type": "compound", "all": [{ "type": "kill_npc", "npc": "giant_scarab" }, { "type": "obtain_item", "item": "scarab_shell" }] } },
        { "id": "b_med_5", "description": "Navigate the pyramid entrance to the first chamber.", "check": { "type": "enter_area", "area": "pyramid_chamber_1" } },
        { "id": "b_med_6", "description": "Equip a desert amulet.", "check": { "type": "equip_item", "item": "desert_amulet" } },
        { "id": "b_med_7", "description": "Kill a skeleton mage.", "check": { "type": "kill_npc", "npc": "skeleton_mage" } },
        { "id": "b_med_8", "description": "Collect 10 bone shards in one trip.", "check": { "type": "obtain_item_in_trip", "item": "bone_shard", "count": 10 } },
        { "id": "b_med_9", "description": "Pickpocket a warrior in the nomad camp.", "check": { "type": "pickpocket_npc", "npc": "warrior", "area": "nomad_camp" } },
        { "id": "b_med_10", "description": "Equip a full nomad outfit and salute Razak.", "check": { "type": "compound", "all": [{ "type": "equip_set", "set": "nomad_outfit" }, { "type": "emote_at_npc", "emote": "salute", "npc": "razak" }] } }
      ],
      "reward": "Boneyard cape (medium) + oasis bank teleport. Diary lamp (medium).",
      "perk_description": "Oasis bank access; +10% scarab shell drop rate; sand-storm damage halved."
    },
    "hard": {
      "tasks": [
        { "id": "b_hard_1", "description": "Defeat the Bog Hydra.", "check": { "type": "boss_kill", "boss": "bog_hydra" } },
        { "id": "b_hard_2", "description": "Kill a fossil guardian.", "check": { "type": "kill_npc", "npc": "fossil_guardian" } },
        { "id": "b_hard_3", "description": "Complete the Relics of the Old World quest.", "check": { "type": "quest_complete", "quest": "relics_of_the_old_world" } },
        { "id": "b_hard_4", "description": "Mine granite (mining 45).", "check": { "type": "mine_items", "items": ["granite"], "min_level": { "mining": 45 } } },
        { "id": "b_hard_5", "description": "Kill a mummy and survive the poison.", "check": { "type": "compound", "all": [{ "type": "kill_npc", "npc": "mummy" }, { "type": "survive_status", "status": "poison" }] } },
        { "id": "b_hard_6", "description": "Collect a fossilized fang.", "check": { "type": "obtain_item", "item": "fossilized_fang" } },
        { "id": "b_hard_7", "description": "Smith a soot-iron weapon.", "check": { "type": "smith_item", "item_tag": "soot_iron_weapon" } },
        { "id": "b_hard_8", "description": "Use the Ancient Magicks spellbook in the Boneyard.", "check": { "type": "cast_spellbook", "spellbook": "ancient", "area": "boneyard" } },
        { "id": "b_hard_9", "description": "Kill a skeletal wyvern.", "check": { "type": "kill_npc", "npc": "skeletal_wyvern" } },
        { "id": "b_hard_10", "description": "Reach the bottom of the pyramid dungeon.", "check": { "type": "enter_area", "area": "pyramid_deep" } }
      ],
      "reward": "Boneyard cape (hard) + desert amulet upgrade (5 teleport charges). Diary lamp (hard).",
      "perk_description": "Pyramid shortcut to deep level; +10% bone-shard mining at all desert rocks."
    },
    "elite": {
      "tasks": [
        { "id": "b_elite_1", "description": "Defeat Azhmari in under 3 minutes.", "check": { "type": "boss_kill_under_time", "boss": "azhmari_sand_prince", "seconds": 180 } },
        { "id": "b_elite_2", "description": "Complete the Desert Treasure quest.", "check": { "type": "quest_complete", "quest": "desert_treasure" } },
        { "id": "b_elite_3", "description": "Kill 100 skeletons in the Boneyard.", "check": { "type": "kill_npc", "npc": "skeleton", "count": 100, "area": "boneyard" } },
        { "id": "b_elite_4", "description": "Collect all 3 Azhmari unique drops.", "check": { "type": "collection_log_complete", "source": "azhmari_sand_prince" } },
        { "id": "b_elite_5", "description": "Mine a runite ore in the desert.", "check": { "type": "mine_items", "items": ["runite_ore"], "area": "boneyard" } },
        { "id": "b_elite_6", "description": "Complete every Boneyard quest.", "check": { "type": "all_region_quests_complete", "region": "boneyard" } },
        { "id": "b_elite_7", "description": "Kill a camel warrior.", "check": { "type": "kill_npc", "npc": "camel_warrior" } },
        { "id": "b_elite_8", "description": "Use Ice Barrage on a dust devil stack.", "check": { "type": "cast_spell_on_stack", "spell": "ice_barrage", "npc": "dust_devil", "min_targets": 3 } },
        { "id": "b_elite_9", "description": "Survive 5 minutes in the deep pyramid without food.", "check": { "type": "survive_in_area_without_food", "area": "pyramid_deep", "seconds": 300 } },
        { "id": "b_elite_10", "description": "Complete an elite clue step in the Boneyard.", "check": { "type": "clue_step_complete", "tier": "elite", "region": "boneyard" } }
      ],
      "reward": "Boneyard cape (elite — sand-trim recolour), unlimited desert teleport, sandstorm immunity. Diary lamp (elite).",
      "perk_description": "Sandstorm immunity; +10% rune chance from Boneyard monsters; teleport-to-Azhmari unlocked."
    }
  }
}
